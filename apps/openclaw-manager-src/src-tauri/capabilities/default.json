{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "OpenClaw 默认权限配置 — WebView 不直接读写本地文件",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-open",
      "allow": [
        { "url": "https://**" },
        { "url": "http://127.0.0.1:**" },
        { "url": "http://localhost:**" }
      ]
    },
    "process:default",
    "notification:default"
  ]
}
