# Oracle 的 frist-api.service 实际读取 /etc/frist-api/frist-api.env；部署时复制所需项到该文件，不要把本模板当作运行时配置。
NODE_ENV=production
FRIST_API_PUBLIC_MODE=1
FRIST_API_ADMIN_TOKEN=replace-with-a-long-random-admin-token
FRIST_API_ADMIN_PAGE_CODE=replace-with-hidden-admin-entry-code
FRIST_API_ADMIN_CLAIM_CODES=replace-with-one-time-owner-claim-code
FRIST_API_SESSION_SECRET=replace-with-a-long-random-session-secret
FRIST_API_SESSION_TTL_MS=604800000
FRIST_API_PASSWORD_HASH_SECRET=replace-with-a-long-random-password-hash-secret
FRIST_API_LEGACY_PASSWORD_HASH_SECRETS=
FRIST_API_DATA_ENCRYPTION_KEY=replace-with-a-long-random-runtime-encryption-key
FRIST_API_PUBLIC_GATEWAY_BASE_URL=https://jiyu.245334.xyz/v1
FRIST_API_CANONICAL_HOST=jiyu.245334.xyz
FRIST_API_REDIRECT_HOSTS=245334.xyz,frist-api.245334.xyz,frist-api.101-43-41-96.nip.io,101-43-41-96.nip.io
FRIST_API_ENFORCE_PRODUCTION_READINESS=1
FRIST_API_ALLOW_INSECURE_PUBLIC_HTTP=0
FRIST_API_REQUIRE_CSRF=1
FRIST_API_REQUIRE_ADMIN_2FA=1
FRIST_API_ADMIN_TOTP_SECRETS=replace-with-base32-totp-secret
FRIST_API_ADMIN_2FA_SESSION_TTL_MS=3600000
FRIST_API_ADMIN_2FA_RATE_LIMIT_MAX=5
FRIST_API_ADMIN_2FA_RATE_LIMIT_WINDOW_MS=900000
FRIST_API_REQUIRE_EMAIL_VERIFICATION=1
FRIST_API_EMAIL_VERIFICATION_RATE_LIMIT_MAX=5
FRIST_API_EMAIL_VERIFICATION_RATE_LIMIT_WINDOW_MS=900000
FRIST_API_ALLOW_PRIVATE_UPSTREAM_URLS=0
FRIST_API_BACKUP_STATUS_MAX_AGE_HOURS=26
FRIST_API_SLA_RETENTION_DAYS=30
FRIST_API_PROBE_TIMEOUT_MS=8000
FRIST_API_ALLOW_DEMO_RECHARGE=0
FRIST_API_EXPOSE_VERIFICATION_CODE=0
FRIST_API_REQUIRE_CAPTCHA=1
FRIST_API_CAPTCHA_MAX_ATTEMPTS=3
FRIST_API_REQUIRE_TURNSTILE=1
FRIST_API_TURNSTILE_SITE_KEY=replace-with-cloudflare-turnstile-site-key
FRIST_API_TURNSTILE_SECRET=replace-with-cloudflare-turnstile-secret-key
FRIST_API_TURNSTILE_ALLOWED_HOSTNAMES=jiyu.245334.xyz
FRIST_API_PASSWORD_RESET_TTL_MS=900000
FRIST_API_AUTH_RATE_LIMIT_MAX=20
FRIST_API_AUTH_RATE_LIMIT_WINDOW_MS=60000
FRIST_API_PASSWORD_RESET_REQUEST_RATE_LIMIT_MAX=3
FRIST_API_PASSWORD_RESET_REQUEST_RATE_LIMIT_WINDOW_MS=900000
FRIST_API_PASSWORD_RESET_CONFIRM_RATE_LIMIT_MAX=5
FRIST_API_PASSWORD_RESET_CONFIRM_RATE_LIMIT_WINDOW_MS=900000
FRIST_API_RATE_LIMIT_MAX_ENTRIES=10000
FRIST_API_TRUSTED_PROXY_IPS=127.0.0.1
FRIST_API_REDEEM_RATE_LIMIT_MAX=12
FRIST_API_REDEEM_RATE_LIMIT_WINDOW_MS=60000
FRIST_API_LOW_INVENTORY_WEBHOOK=
FRIST_API_CHANNEL_MONITOR_ENABLED=1
FRIST_API_CHANNEL_MONITOR_INTERVAL_MS=60000
FRIST_API_CHANNEL_MONITOR_BATCH_SIZE=4
FRIST_API_CHANNEL_MONITOR_COOLDOWN_MS=55000
FRIST_API_RATE_MARKUP=0.1
FRIST_API_XIANYU_WEBHOOK_TOKEN=replace-with-low-scope-xianyu-auto-ship-token
FRIST_API_CARD_AUTOREPLENISH_ENABLED=1
FRIST_API_CARD_AUTOREPLENISH_INTERVAL_MS=86400000
FRIST_API_CARD_AUTOREPLENISH_DAILY_CAP=50
FRIST_API_CARD_AUTOREPLENISH_SAFETY_STOCK=
FRIST_API_UPSTREAM_BALANCE_SYNC_ENABLED=1
FRIST_API_UPSTREAM_BALANCE_SYNC_INTERVAL_MS=86400000
FRIST_API_UPSTREAM_BALANCE_WARNING_CNY=50
FRIST_API_UPSTREAM_BALANCE_CRITICAL_CNY=20
FRIST_API_UPSTREAM_BALANCE_STALE_HOURS=26
FRIST_API_UPSTREAM_BALANCE_WEBHOOK=
FRIST_API_KEY_ALERT_WEBHOOK=
FRIST_API_TELEGRAM_BOT_TOKEN=
FRIST_API_TELEGRAM_CHAT_ID=
FRIST_API_SMTP_HOST=smtp.example.com
FRIST_API_SMTP_PORT=465
FRIST_API_SMTP_SECURE=1
FRIST_API_SMTP_FAMILY=auto
FRIST_API_SMTP_USER=alerts@example.com
FRIST_API_SMTP_PASSWORD=replace-with-mail-app-password
FRIST_API_SMTP_FROM=alerts@example.com
FRIST_API_BALANCE_ALERT_FROM_NAME=CC中转 Billing
FRIST_API_PAYMENT_ENABLED=1
FRIST_API_PAYMENT_REQUEST_TIMEOUT_MS=15000
FRIST_API_WECHAT_PAY_ENABLED=0
FRIST_API_WECHAT_PAY_APPID=replace-after-wechat-merchant-registration
FRIST_API_WECHAT_PAY_MCH_ID=replace-after-wechat-merchant-registration
FRIST_API_WECHAT_PAY_SERIAL_NO=replace-with-wechat-api-cert-serial
FRIST_API_WECHAT_PAY_PRIVATE_KEY=replace-with-wechat-merchant-private-key
FRIST_API_WECHAT_PAY_PUBLIC_KEY=replace-with-wechat-platform-public-key
FRIST_API_WECHAT_PAY_PLATFORM_SERIAL_NO=replace-with-wechat-platform-cert-serial-or-public-key-id
FRIST_API_WECHAT_PAY_API_V3_KEY=replace-with-32-byte-wechat-api-v3-key
FRIST_API_WECHAT_PAY_NOTIFY_URL=https://jiyu.245334.xyz/api/frist/payments/wechat/notify
FRIST_API_ALIPAY_ENABLED=0
FRIST_API_ALIPAY_APP_ID=replace-after-alipay-app-registration
FRIST_API_ALIPAY_PRIVATE_KEY=replace-with-alipay-app-private-key
FRIST_API_ALIPAY_PUBLIC_KEY=replace-with-alipay-public-key
FRIST_API_ALIPAY_NOTIFY_URL=https://jiyu.245334.xyz/api/frist/payments/alipay/notify
FRIST_API_NEWAPI_ENABLED=1
FRIST_API_REQUIRE_NEWAPI_DATABASE=1
FRIST_API_NEWAPI_BASE_URL=http://openclaw-newapi:3000
FRIST_API_NEWAPI_ACCESS_TOKEN=replace-with-new-api-user-access-token
FRIST_API_NEWAPI_USER_ID=1
FRIST_API_NEWAPI_DEFAULT_GROUP=default
# 单位是本地人民币分，例如 7200 表示单次最多划转 72 元；服务端再换算为 New-API quota units。
FRIST_API_NEWAPI_DEFAULT_TOKEN_QUOTA=replace-with-positive-local-cny-cents
FRIST_API_NEWAPI_REQUEST_TIMEOUT_MS=15000
FRIST_API_NEWAPI_GATEWAY_ENABLED=1
FRIST_API_NEWAPI_GATEWAY_BASE_URL=http://127.0.0.1:13000/v1
FRIST_API_NEWAPI_REDEMPTION_STATUS_SYNC_ENABLED=1
FRIST_API_NEWAPI_REDEMPTION_STATUS_SYNC_INTERVAL_MS=60000
