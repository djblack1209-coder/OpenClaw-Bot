# Deny by default. Only reviewed source/config templates enter the build context.
**
!Dockerfile
!.dockerignore
!requirements-lock.txt
!multi_main.py
!src/**/*.py
!src/intel/db/intel_brief_schema.sql
!src/sub2_replenish/static/app.js
!src/sub2_replenish/static/index.html
!config/.env.example
!config/bot_profiles.py
!config/prompts.py
!config/llm_routing.json
!config/notifications.yaml
!config/omega.yaml
!assets/intel/openclaw-intel-brief-dark.jpg
# Never follow source-tree runtime material, caches or private credentials.
**/__pycache__/**
**/.git/**
**/.venv*/**
**/node_modules/**
**/.env
**/.env.*
!config/.env.example
**/*.pem
**/*.key
**/*.sqlite*
**/*.db
