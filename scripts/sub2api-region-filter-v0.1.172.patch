diff --git a/backend/internal/server/middleware/jiyu_region.go b/backend/internal/server/middleware/jiyu_region.go
new file mode 100644
index 0000000..54283d5
--- /dev/null
+++ b/backend/internal/server/middleware/jiyu_region.go
@@ -0,0 +1,30 @@
+package middleware
+
+import (
+	"net/http"
+	"os"
+	"strings"
+
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/gin-gonic/gin"
+)
+
+// enforceJiyuRegion applies the production split at the shared API-key gate.
+// Cloudflare/Apache supplies X-JIYU-Country after stripping the client header;
+// missing or malformed values are deliberately treated as restricted.
+func enforceJiyuRegion(c *gin.Context, group *service.Group) bool {
+	if os.Getenv("SUB2API_JIYU_REGION_ENFORCEMENT") != "1" {
+		return true
+	}
+	if group == nil {
+		return true
+	}
+	country := strings.ToUpper(strings.TrimSpace(c.GetHeader("X-JIYU-Country")))
+	mainlandOrUnknown := country == "" || country == "CN" || len(country) != 2
+	if !mainlandOrUnknown || strings.Contains(group.Description, "region=cn") {
+		return true
+	}
+	service.MarkOpsClientBusinessLimited(c, service.OpsClientBusinessLimitedReasonLocalFeatureGate)
+	AbortWithError(c, http.StatusForbidden, "REGION_MODEL_RESTRICTED", "This model group is unavailable in the current region")
+	return false
+}
diff --git a/backend/internal/server/middleware/jiyu_region_test.go b/backend/internal/server/middleware/jiyu_region_test.go
new file mode 100644
index 0000000..6862251
--- /dev/null
+++ b/backend/internal/server/middleware/jiyu_region_test.go
@@ -0,0 +1,35 @@
+package middleware
+
+import (
+	"net/http/httptest"
+	"testing"
+
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/require"
+)
+
+func TestEnforceJiyuRegion(t *testing.T) {
+	t.Setenv("SUB2API_JIYU_REGION_ENFORCEMENT", "1")
+	tests := []struct {
+		name        string
+		country     string
+		description string
+		allowed     bool
+	}{
+		{name: "overseas_allows_global", country: "SG", allowed: true},
+		{name: "mainland_rejects_global", country: "CN", allowed: false},
+		{name: "mainland_allows_domestic", country: "CN", description: "region=cn", allowed: true},
+		{name: "unknown_rejects_global", country: "", allowed: false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			c, _ := gin.CreateTestContext(httptest.NewRecorder())
+			c.Request = httptest.NewRequest("GET", "/v1/models", nil)
+			if tt.country != "" {
+				c.Request.Header.Set("X-JIYU-Country", tt.country)
+			}
+			require.Equal(t, tt.allowed, enforceJiyuRegion(c, &service.Group{Description: tt.description}))
+		})
+	}
+}

