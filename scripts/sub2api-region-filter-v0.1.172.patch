@@ -0,0 +1,35 @@
+package middleware
+
+import (
+	"net/http/httptest"
+	"testing"
+
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/require"
+)
+
+func TestEnforceJiyuRegion(t *testing.T) {
+	t.Setenv("SUB2API_JIYU_REGION_ENFORCEMENT", "1")
+	tests := []struct {
+		name        string
+		country     string
+		description string
+		allowed     bool
+	}{
+		{name: "overseas_allows_global", country: "SG", allowed: true},
+		{name: "mainland_rejects_global", country: "CN", allowed: false},
+		{name: "mainland_allows_domestic", country: "CN", description: "region=cn", allowed: true},
+		{name: "unknown_rejects_global", country: "", allowed: false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			c, _ := gin.CreateTestContext(httptest.NewRecorder())
+			c.Request = httptest.NewRequest("GET", "/v1/models", nil)
+			if tt.country != "" {
+				c.Request.Header.Set("X-JIYU-Country", tt.country)
+			}
+			require.Equal(t, tt.allowed, enforceJiyuRegion(c, &service.Group{Description: tt.description}))
+		})
+	}
+}
