diff --git a/backend/internal/service/jiyu_region.go b/backend/internal/service/jiyu_region.go
new file mode 100644
index 0000000..5244670
--- /dev/null
+++ b/backend/internal/service/jiyu_region.go
@@ -0,0 +1,17 @@
+package service
+
+import (
+	"os"
+	"strings"
+)
+
+// IsJiyuGroupAllowed keeps the region decision identical across user-facing
+// discovery endpoints and the shared API-key middleware.
+func IsJiyuGroupAllowed(country, description string) bool {
+	if os.Getenv("SUB2API_JIYU_REGION_ENFORCEMENT") != "1" {
+		return true
+	}
+	country = strings.ToUpper(strings.TrimSpace(country))
+	mainlandOrUnknown := country == "" || country == "CN" || len(country) != 2
+	return !mainlandOrUnknown || strings.Contains(strings.ToLower(description), "region=cn")
+}
