index 82df3bb..eae4fe6 100644
--- a/backend/internal/service/update_service.go
+++ b/backend/internal/service/update_service.go
@@ -12,6 +12,7 @@ import (
 	"io"
+	"net"
 	"net/url"
 	"os"
 	"path/filepath"
 	"runtime"
 	"sort"
@@ -163,6 +164,11 @@ func (s *UpdateService) CheckUpdate(ctx context.Context, force bool) (*UpdateInf
 // PerformUpdate downloads and applies the update
 // Uses atomic file replacement pattern for safe in-place updates
 func (s *UpdateService) PerformUpdate(ctx context.Context) error {
+	// JIYU 构建只允许调用 root 管理的固定代理。浏览器不能传入命令、版本或下载地址。
+	if os.Getenv("SUB2API_JIYU_MANAGED_UPDATE") == "1" {
+		return performJiyuManagedUpdate(ctx)
+	}
+
 	info, err := s.CheckUpdate(ctx, true)
 	if err != nil {
 		return err
@@ -175,6 +181,47 @@ func (s *UpdateService) PerformUpdate(ctx context.Context) error {
 	return s.applyReleaseAssets(ctx, info.ReleaseInfo.Assets)
 }
 
+func performJiyuManagedUpdate(ctx context.Context) error {
+	const socketPath = "/run/sub2api-jiyu-update.sock"
+	const maxOutputBytes = 4096
+	dialer := net.Dialer{}
+	conn, err := dialer.DialContext(ctx, "unix", socketPath)
+	if err != nil {
+		return fmt.Errorf("managed update service unavailable: %w", err)
+	}
+	defer conn.Close()
+	if err := conn.SetDeadline(time.Now().Add(15 * time.Minute)); err != nil {
+		return fmt.Errorf("managed update deadline failed: %w", err)
+	}
+	output, err := io.ReadAll(io.LimitReader(conn, maxOutputBytes+1))
+	if err != nil {
+		return fmt.Errorf("managed update response failed: %w", err)
+	}
+	if len(output) > maxOutputBytes {
+		return fmt.Errorf("managed update response exceeded safety limit")
+	}
+	message := strings.TrimSpace(string(output))
+	parts := strings.SplitN(message, "\n", 2)
+	status := parts[0]
+	details := ""
+	if len(parts) == 2 {
+		details = strings.TrimSpace(parts[1])
+	}
+	switch status {
+	case "JIYU_UPDATE_STATUS=noop":
+		return ErrNoUpdateAvailable
+	case "JIYU_UPDATE_STATUS=staged":
+		return nil
+	case "JIYU_UPDATE_STATUS=error":
+		if details == "" {
+			details = "JIYU compatibility package is unavailable"
+		}
+		return fmt.Errorf("managed update failed: %s", details)
+	default:
+		return fmt.Errorf("managed update returned an invalid response")
+	}
+}
+
 // applyReleaseAssets downloads the platform archive from the given release assets,
 // verifies its checksum, and atomically swaps the running binary.
 // Shared by PerformUpdate (latest) and RollbackToVersion (specific older version).
