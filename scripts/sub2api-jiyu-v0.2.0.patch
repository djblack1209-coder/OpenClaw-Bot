diff --git a/frontend/src/utils/channelMonitorDisplayOrder.ts b/frontend/src/utils/channelMonitorDisplayOrder.ts
new file mode 100644
index 0000000..7c35f18
--- /dev/null
+++ b/frontend/src/utils/channelMonitorDisplayOrder.ts
@@ -0,0 +1,39 @@
+const MONITOR_PRODUCT_ORDER = [
+  'Claude Kiro',
+  'Claude 官 Key',
+  'OpenAI Plus',
+  'OpenAI Pro',
+  'Grok',
+  '生图',
+]
+
+interface MonitorDisplayItem {
+  id: number
+  name: string
+  group_name?: string | null
+}
+
+function monitorLabel(item: MonitorDisplayItem): string {
+  return `${item.group_name || ''} ${item.name || ''}`
+}
+
+export function compareMonitorDisplayOrder(
+  left: MonitorDisplayItem,
+  right: MonitorDisplayItem,
+): number {
+  const leftLabel = monitorLabel(left)
+  const rightLabel = monitorLabel(right)
+  const channelRank = (label: string) =>
+    label.includes('渠道A') ? 0 : label.includes('渠道B') ? 1 : 2
+  const productRank = (label: string) => {
+    const rank = MONITOR_PRODUCT_ORDER.findIndex((product) => label.includes(product))
+    return rank === -1 ? MONITOR_PRODUCT_ORDER.length : rank
+  }
+
+  return (
+    channelRank(leftLabel) - channelRank(rightLabel) ||
+    productRank(leftLabel) - productRank(rightLabel) ||
+    leftLabel.localeCompare(rightLabel, 'zh-CN') ||
+    left.id - right.id
+  )
+}
