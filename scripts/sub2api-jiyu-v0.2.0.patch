+func performJiyuManagedUpdate(ctx context.Context) error {
+	const socketPath = "/run/sub2api-jiyu-update.sock"
+	const maxOutputBytes = 4096
+	dialer := net.Dialer{}
+	conn, err := dialer.DialContext(ctx, "unix", socketPath)
+	if err != nil {
+		return fmt.Errorf("managed update service unavailable: %w", err)
+	}
+	defer conn.Close()
+	if err := conn.SetDeadline(time.Now().Add(15 * time.Minute)); err != nil {
+		return fmt.Errorf("managed update deadline failed: %w", err)
+	}
+	output, err := io.ReadAll(io.LimitReader(conn, maxOutputBytes+1))
+	if err != nil {
+		return fmt.Errorf("managed update response failed: %w", err)
+	}
+	if len(output) > maxOutputBytes {
+		return fmt.Errorf("managed update response exceeded safety limit")
+	}
+	message := strings.TrimSpace(string(output))
+	parts := strings.SplitN(message, "\n", 2)
+	status := parts[0]
+	details := ""
+	if len(parts) == 2 {
+		details = strings.TrimSpace(parts[1])
+	}
+	switch status {
+	case "JIYU_UPDATE_STATUS=noop":
+		return ErrNoUpdateAvailable
+	case "JIYU_UPDATE_STATUS=staged":
+		return nil
+	case "JIYU_UPDATE_STATUS=error":
+		if details == "" {
+			details = "JIYU compatibility package is unavailable"
+		}
+		return fmt.Errorf("managed update failed: %s", details)
+	default:
+		return fmt.Errorf("managed update returned an invalid response")
+	}
+}
+
