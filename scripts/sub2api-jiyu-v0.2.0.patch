 func (s *UpdateService) PerformUpdate(ctx context.Context) error {
+	// JIYU 构建只允许调用 root 管理的固定代理。浏览器不能传入命令、版本或下载地址。
+	if os.Getenv("SUB2API_JIYU_MANAGED_UPDATE") == "1" {
