+// sqlChannelMonitorCredentialResolver resolves the current active account
+// through the existing channel -> group -> account binding. The query returns
+// secrets only to the in-process probe; it never logs or persists them.
+type sqlChannelMonitorCredentialResolver struct {
+	db *sql.DB
+}
+
+// NewSQLChannelMonitorCredentialResolver creates the production resolver.
+func NewSQLChannelMonitorCredentialResolver(db *sql.DB) ChannelMonitorCredentialResolver {
+	if db == nil {
+		return nil
+	}
+	return &sqlChannelMonitorCredentialResolver{db: db}
+}
+
+func (r *sqlChannelMonitorCredentialResolver) Resolve(ctx context.Context, monitor *ChannelMonitor) (endpoint, apiKey string, found bool, err error) {
+	if r == nil || r.db == nil || monitor == nil || strings.TrimSpace(monitor.GroupName) == "" {
+		return "", "", false, nil
+	}
+	err = r.db.QueryRowContext(ctx, `
+		SELECT COALESCE(a.credentials->>'base_url', ''),
+		       COALESCE(a.credentials->>'api_key', '')
+		FROM channels c
+		JOIN channel_groups cg ON cg.channel_id = c.id
+		JOIN groups g ON g.id = cg.group_id
+		JOIN account_groups ag ON ag.group_id = g.id
+		JOIN accounts a ON a.id = ag.account_id
+		WHERE c.status = 'active'
+		  AND g.status = 'active'
+		  AND g.deleted_at IS NULL
+		  AND a.status = 'active'
+		  AND a.deleted_at IS NULL
+		  AND g.platform = $2
+		  AND (c.name = $1 OR g.name = $1)
+		ORDER BY CASE WHEN c.name = $1 THEN 0 ELSE 1 END,
+		         ag.priority ASC,
+		         a.id ASC
+		LIMIT 1`, strings.TrimSpace(monitor.GroupName), monitor.Provider).Scan(&endpoint, &apiKey)
+	if errors.Is(err, sql.ErrNoRows) {
+		var managed bool
+		err = r.db.QueryRowContext(ctx, `
+			SELECT EXISTS (
+				SELECT 1
+				FROM channels c
+				JOIN channel_groups cg ON cg.channel_id = c.id
+				JOIN groups g ON g.id = cg.group_id
+				WHERE g.platform = $2
+				  AND (c.name = $1 OR g.name = $1)
+			)`, strings.TrimSpace(monitor.GroupName), monitor.Provider).Scan(&managed)
+		if err != nil {
+			return "", "", false, err
+		}
+		if managed {
+			return "", "", false, ErrChannelMonitorManagedBindingInactive
+		}
+		// Standalone monitors created outside a JIYU channel keep their legacy
+		// snapshot and remain compatible with the existing V1 UI.
+		return "", "", false, nil
+	}
+	if err != nil {
+		return "", "", false, err
+	}
+	apiKey = strings.TrimSpace(apiKey)
+	if apiKey == "" {
+		return "", "", false, fmt.Errorf("channel account has no active api key")
+	}
+	endpoint = strings.TrimRight(strings.TrimSpace(endpoint), "/")
+	if strings.HasSuffix(endpoint, "/v1") {
+		endpoint = strings.TrimSuffix(endpoint, "/v1")
+	}
+	if endpoint == "" {
+		endpoint = monitor.Endpoint
+	}
+	return endpoint, apiKey, true, nil
+}
