+func TestSQLChannelMonitorCredentialResolverUsesCurrentAccount(t *testing.T) {
+	db, mock, err := sqlmock.New()
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = db.Close() })
+
+	mock.ExpectQuery("SELECT COALESCE").
+		WithArgs("JIYU 渠道A · OpenAI Plus", "openai").
+		WillReturnRows(sqlmock.NewRows([]string{"base_url", "api_key"}).
+			AddRow("https://upstream.test/v1", "runtime-key"))
+
+	resolver := NewSQLChannelMonitorCredentialResolver(db)
+	endpoint, apiKey, found, err := resolver.Resolve(context.Background(), &ChannelMonitor{
+		GroupName: "JIYU 渠道A · OpenAI Plus",
+		Provider:  "openai",
+		Endpoint:  "https://legacy.test",
+	})
+	require.NoError(t, err)
+	require.True(t, found)
+	require.Equal(t, "https://upstream.test", endpoint)
+	require.Equal(t, "runtime-key", apiKey)
+	require.NoError(t, mock.ExpectationsWereMet())
+}
+
+func TestSQLChannelMonitorCredentialResolverIgnoresDisabledManagedBinding(t *testing.T) {
+	db, mock, err := sqlmock.New()
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = db.Close() })
+
+	mock.ExpectQuery("SELECT COALESCE").
+		WithArgs("JIYU 渠道A · OpenAI Pro", "openai").
+		WillReturnRows(sqlmock.NewRows([]string{"base_url", "api_key"}))
+	mock.ExpectQuery("SELECT EXISTS").
+		WithArgs("JIYU 渠道A · OpenAI Pro", "openai").
+		WillReturnRows(sqlmock.NewRows([]string{"exists"}).AddRow(true))
+
+	resolver := NewSQLChannelMonitorCredentialResolver(db)
+	_, _, found, err := resolver.Resolve(context.Background(), &ChannelMonitor{
+		GroupName: "JIYU 渠道A · OpenAI Pro",
+		Provider:  "openai",
+		Endpoint:  "https://legacy.test",
+	})
+	require.ErrorIs(t, err, ErrChannelMonitorManagedBindingInactive)
+	require.False(t, found)
+	require.NoError(t, mock.ExpectationsWereMet())
+}
+
+func TestRunCheckDisablesInactiveManagedBindingWithoutProbe(t *testing.T) {
+	repo := &inactiveBindingRepositoryStub{monitor: &ChannelMonitor{ID: 41, APIKey: ""}}
+	scheduler := &inactiveBindingSchedulerStub{}
+	svc := NewChannelMonitorService(repo, nil)
+	svc.SetRuntimeReader(inactiveBindingRuntimeStub{})
+	svc.SetCredentialResolver(inactiveBindingResolverStub{})
+	svc.SetScheduler(scheduler)
+
+	results, err := svc.RunCheck(context.Background(), 41)
+	require.ErrorIs(t, err, ErrChannelMonitorManagedBindingInactive)
+	require.Nil(t, results)
+	require.Equal(t, []int64{41}, repo.disabledIDs)
+	require.Equal(t, []int64{41}, scheduler.unscheduledIDs)
+}
